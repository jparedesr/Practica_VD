"4625017" = "POBLATS DEL NORD", "4625010" = "MONT-OLIVET", "4625012" = "AIORA",
"4625009" = "LA RAIOSA", "4625003" = "LA ROQUETA", "4625011" = "CABANYAL-CANYAMELAR",
"4625005" = "MORVEDRE", "4625010" = "LA PUNTA", "4625010" = "NA ROVELLA"
)
# ==============================================================================
# 1B. ANCLAJE MATRICIAL DE PROVINCIAS (Incluyendo Málaga)
# ==============================================================================
df_map_ciudades <- data.frame(
CLAVE_GEO = names(mapeo_completo),
Zona_Txt = mapeo_completo,
stringsAsFactors = FALSE
) %>%
mutate(Ciudad = case_when(
str_starts(CLAVE_GEO, "08019") ~ "Barcelona",
str_starts(CLAVE_GEO, "28079") ~ "Madrid",
str_starts(CLAVE_GEO, "46250") ~ "Valencia",
str_starts(CLAVE_GEO, "41091") ~ "Sevilla",
str_starts(CLAVE_GEO, "29067") ~ "Malaga",
str_starts(CLAVE_GEO, "17")    ~ "Girona",
str_starts(CLAVE_GEO, "01") | str_starts(CLAVE_GEO, "48") | str_starts(CLAVE_GEO, "20") ~ "Euskadi",
CLAVE_GEO %in% c("07024", "07015", "07002", "07032", "07064", "07052", "07023", "07902") ~ "Menorca",
str_starts(CLAVE_GEO, "07")    ~ "Mallorca",
TRUE ~ NA_character_
))
# Función extractor INE plana (para Municipios)
extraer_datos_ine <- function(ruta_archivo, col_valor, longitud_codigo, nombre_metrica) {
df_raw <- read_excel(ruta_archivo, col_names = FALSE)
df_raw %>%
mutate(Texto_Celda = str_trim(as.character(...1))) %>%
filter(str_detect(Texto_Celda, "^\\d+")) %>%
mutate(RAW_CLAVE = str_extract(Texto_Celda, "^\\d+")) %>%
filter(str_length(RAW_CLAVE) == longitud_codigo) %>%
transmute(
CLAVE_GEO = RAW_CLAVE,
!!nombre_metrica := as.numeric(.data[[names(df_raw)[col_valor]]])
) %>%
filter(!is.na(!!sym(nombre_metrica)))
}
# Carga de demografía base a 5 dígitos (solo Municipios)
df_pob_base_mun <- extraer_datos_ine("población.xlsx", 2, 5, "Pob_Residente") %>% distinct(CLAVE_GEO, .keep_all = TRUE)
df_hog_base_mun <- extraer_datos_ine("hogares1persona.xlsx", 3, 5, "Hogares_1Pers") %>% distinct(CLAVE_GEO, .keep_all = TRUE)
# ==============================================================================
# ETAPA 1: SOCIOECONÓMICO A NIVEL DE DISTRITOS (7 CIFRAS - INCLUYE MÁLAGA)
# ==============================================================================
df_rentas_dist <- extraer_datos_ine("rentas.xlsx", 11, 7, "Renta_Hogar") %>% distinct(CLAVE_GEO, .keep_all = TRUE)
df_mivau_dist <- read_excel("precio-alquiler.xlsx", sheet = "Distritos") %>%
select(CUDIS, ALQM2_LV_M_VC_19, ALQM2_LV_M_VC_24) %>%
mutate(CLAVE_GEO = str_pad(as.character(CUDIS), width = 7, side = "left", pad = "0")) %>% select(-CUDIS)
# REPARADO: Carga limpia desde Excel aplicando str_pad para evitar pérdidas de ceros
df_pob_real_dist <- read_excel("poblacionDistritos.xlsx") %>%
mutate(CLAVE_GEO = str_pad(as.character(CUDIS), width = 7, side = "left", pad = "0")) %>%
transmute(CLAVE_GEO, Pob_Residente = as.numeric(Total)) %>%
distinct(CLAVE_GEO, .keep_all = TRUE)
df_hog_real_dist <- read_excel("hogaresDistritos.xlsx") %>%
mutate(CLAVE_GEO = str_pad(as.character(CUDIS), width = 7, side = "left", pad = "0")) %>%
transmute(CLAVE_GEO, Hogares_1Pers = as.numeric(`1 Persona`)) %>%
distinct(CLAVE_GEO, .keep_all = TRUE)
# Ensamble de la Etapa 1 por distritos
df_socio_dist_total <- df_rentas_dist %>%
inner_join(df_mivau_dist, by = "CLAVE_GEO") %>%
left_join(df_pob_real_dist, by = "CLAVE_GEO") %>%
left_join(df_hog_real_dist, by = "CLAVE_GEO") %>%
inner_join(df_map_ciudades, by = "CLAVE_GEO")
# ==============================================================================
# ETAPA 2: SOCIOECONÓMICO A NIVEL DE MUNICIPIOS (5 CIFRAS)
# ==============================================================================
df_rentas_mun <- extraer_datos_ine("rentas.xlsx", 11, 5, "Renta_Hogar") %>% distinct(CLAVE_GEO, .keep_all = TRUE)
df_mivau_mun <- read_excel("precio-alquiler.xlsx", sheet = "Municipios") %>%
select(CUMUN, ALQM2_LV_M_VC_19, ALQM2_LV_M_VC_24) %>%
mutate(CLAVE_GEO = str_pad(as.character(CUMUN), width = 5, side = "left", pad = "0")) %>% select(-CUMUN)
df_socio_mun_total <- df_pob_base_mun %>%
inner_join(df_rentas_mun, by = "CLAVE_GEO") %>%
inner_join(df_hog_base_mun, by = "CLAVE_GEO") %>%
inner_join(df_mivau_mun, by = "CLAVE_GEO") %>%
inner_join(df_map_ciudades, by = "CLAVE_GEO")
# Consolidado general unificado
df_socio_total_limpio <- bind_rows(df_socio_dist_total, df_socio_mun_total)
# ==============================================================================
# ETAPA 3: EXTRACCIÓN GLOBAL DE AIRBNB (9 PESTAÑAS - INCLUYE MÁLAGA)
# ==============================================================================
hojas_airbnb <- excel_sheets("airbnb.xlsx")
todas_las_ciudades <- c('Madrid', 'Barcelona', 'Valencia', 'Sevilla', 'Malaga', 'Girona', 'Euskadi', 'Mallorca', 'Menorca')
airbnb_consolidado_list <- list()
for (ciudad in todas_las_ciudades) {
if (ciudad %in% hojas_airbnb) {
df_air <- read_excel("airbnb.xlsx", sheet = ciudad) %>% filter(room_type == "Entire home/apt")
col_agrupacion <- ifelse(ciudad %in= c("Malaga", "Girona", "Euskadi", "Mallorca", "Menorca"), "neighbourhood", "neighbourhood_group")
# ==============================================================================
# ETAPA 3: EXTRACCIÓN GLOBAL DE AIRBNB (9 PESTAÑAS - INCLUYE MÁLAGA)
# ==============================================================================
hojas_airbnb <- excel_sheets("airbnb.xlsx")
todas_las_ciudades <- c('Madrid', 'Barcelona', 'Valencia', 'Sevilla', 'Malaga', 'Girona', 'Euskadi', 'Mallorca', 'Menorca')
airbnb_consolidado_list <- list()
for (ciudad in todas_las_ciudades) {
if (ciudad %in% hojas_airbnb) {
df_air <- read_excel("airbnb.xlsx", sheet = ciudad) %>% filter(room_type == "Entire home/apt")
# CORREGIDO: Cambiado %in= por %in%
col_agrupacion <- ifelse(ciudad %in% c("Malaga", "Girona", "Euskadi", "Mallorca", "Menorca"), "neighbourhood", "neighbourhood_group")
df_air_agrupado <- df_air %>%
group_by(Zona_Txt = .data[[col_agrupacion]]) %>%
summarise(
Viviendas_Tur_Total = n(),
Viviendas_Prof_Total = sum(calculated_host_listings_count > 3, na.rm = TRUE),
.groups = "drop"
) %>% mutate(Ciudad = ciudad)
airbnb_consolidado_list[[ciudad]] <- df_air_agrupado
}
}
df_airbnb_total <- bind_rows(airbnb_consolidado_list)
# ==============================================================================
# ETAPA 4: CRUCE DE AMBOS CRITERIOS Y CÁLCULO DE KPIs PARA FLOURISH
# ==============================================================================
message(">>> Ejecutando cruce blindado por Ciudad y Territorio...")
df_resultado_final <- df_airbnb_total %>%
inner_join(df_socio_total_limpio, by = c("Ciudad", "Zona_Txt")) %>%
mutate(
ID_UNICO               = str_c(str_to_upper(Ciudad), "_", str_to_upper(Zona_Txt)),
Variacion_Alquiler_Pct = ((ALQM2_LV_M_VC_24 - ALQM2_LV_M_VC_19) / ALQM2_LV_M_VC_19) * 100,
Densidad_Turistica      = (Viviendas_Tur_Total / Pob_Residente) * 1000,
Pct_Profesional         = (Viviendas_Prof_Total / Viviendas_Tur_Total) * 100,
IPG_Indice              = Densidad_Turistica * Variacion_Alquiler_Pct,
Pct_Vulnerabilidad_G    = (Hogares_1Pers / Pob_Residente) * 100
) %>%
select(
ID_UNICO, CLAVE_GEO, Ciudad, Barrio_Distrito_Municipio = Zona_Txt, Pob_Residente,
Renta_Hogar, Pct_Vulnerabilidad_G, Viviendas_Tur_Total,
Pct_Profesional, Densidad_Turistica, Variacion_Alquiler_Pct, IPG_Indice
)
write_excel_csv(df_resultado_final, "dataset_visualizacion_final.csv")
message(">>> ¡PROCESO COMPLETADO! Dataset maestro generado con éxito para las 5 ciudades e islas.")
