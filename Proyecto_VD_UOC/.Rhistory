# ==============================================================================
# 1B. ANCLAJE MATRICIAL DE PROVINCIAS
# ==============================================================================
df_map_ciudades <- data.frame(
CLAVE_GEO = names(mapeo_completo),
Zona_Txt = mapeo_completo,
stringsAsFactors = FALSE
) %>%
mutate(Ciudad = case_when(
str_starts(CLAVE_GEO, "08019") ~ "Barcelona",
str_starts(CLAVE_GEO, "28079") ~ "Madrid",
str_starts(CLAVE_GEO, "46250") ~ "Valencia",
str_starts(CLAVE_GEO, "41091") ~ "Sevilla",
str_starts(CLAVE_GEO, "29067") ~ "Malaga",
str_starts(CLAVE_GEO, "17")    ~ "Girona",
str_starts(CLAVE_GEO, "01") | str_starts(CLAVE_GEO, "48") | str_starts(CLAVE_GEO, "20") ~ "Euskadi",
CLAVE_GEO %in% c("07024", "07015", "07002", "07032", "07064", "07052", "07023", "07902") ~ "Menorca",
str_starts(CLAVE_GEO, "07")    ~ "Mallorca",
TRUE ~ NA_character_
))
# Función extractor INE (para Municipios)
extraer_datos_ine <- function(ruta_archivo, col_valor, longitud_codigo, nombre_metrica) {
df_raw <- read_excel(ruta_archivo, col_names = FALSE)
df_raw %>%
mutate(Texto_Celda = str_trim(as.character(...1))) %>%
filter(str_detect(Texto_Celda, "^\\d+")) %>%
mutate(RAW_CLAVE = str_extract(Texto_Celda, "^\\d+")) %>%
filter(str_length(RAW_CLAVE) == longitud_codigo) %>%
transmute(
CLAVE_GEO = RAW_CLAVE,
!!nombre_metrica := as.numeric(.data[[names(df_raw)[col_valor]]])
) %>%
filter(!is.na(!!sym(nombre_metrica)))
}
# Carga de demografía base a 5 dígitos (solo Municipios)
df_pob_base_mun <- extraer_datos_ine("población.xlsx", 2, 5, "Pob_Residente") %>% distinct(CLAVE_GEO, .keep_all = TRUE)
